{
  "feature_id": "04",
  "feature_name": "ホーム",
  "version": "v1",
  "note": "route × auth × status の骨格（MAD-WAVE-REPLICATE-04）。web 画面状態は UI/遷移正本参照。契約正本は 契約レジスタ-v1.yaml。",
  "generated": "2026-07-03",
  "auth_model": {
    "landing": "認証後 World 着地（#01 verify / #03 onboarding complete 後）",
    "read_only": "ホームは read-only サマリーハブ — 編集・fork なし"
  },
  "web_routes": [
    {
      "route": "/",
      "kind": "hub",
      "states": ["loading", "home", "fallback"],
      "primary_action": "観測登録開始",
      "api": ["GET /api/v1/home/summary"]
    },
    {
      "route": "/home",
      "kind": "hub",
      "states": ["loading", "home", "fallback"],
      "primary_action": "観測登録開始",
      "api": ["GET /api/v1/home/summary"]
    }
  ],
  "api_transitions": [
    {
      "method": "GET",
      "path": "/api/v1/home/summary",
      "auth": "public",
      "success": 200,
      "errors": [],
      "on_success": "today_lines + cards + primary_cta",
      "on_error": "例外も 200 + 近似（NF-H-03 · obs_count フォールバック）"
    }
  ],
  "client_transitions": [
    {
      "from": "loading",
      "event": "GET 200",
      "to": "home",
      "next": "primary_cta → /observation/context or card href → FeatureNode"
    },
    {
      "from": "loading",
      "event": "network error",
      "to": "fallback",
      "next": "近似表示 + 全機能/インボックス直接導線"
    }
  ]
}
